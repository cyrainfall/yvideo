        "key": false
      }
    ]
  },
  {
    "id": "caption-group-1",
    "frame": 1,
    "start": 3.069,
    "end": 4.581,
    "text": "树是静止的。",
    "words": [
      {
        "id": "caption-word-1-0",
        "text": "树是静止的。",
        "start": 3.069,
        "end": 4.361,
        "key": false
      }
    ]
  },
  {
    "id": "caption-group-2",
    "frame": 1,
    "start": 4.581,
    "end": 7.12,
    "text": "真正在动的，是一轮对话。",
    "words": [
      {
        "id": "caption-word-2-0",
        "text": "真正在动的，是一轮对话。",
        "start": 4.581,
        "end": 6.9,
        "key": false
      }
    ]
  },
  {
    "id": "caption-group-3",
    "frame": 1,
    "start": 7.12,
    "end": 11.829,
    "text": "你按下回车，一句话进了队列，然后发生了一串事。",
    "words": [
      {
        "id": "caption-word-3-0",
        "text": "你按下回车，一句话进了队列，然后发生了一串事。",
        "start": 7.12,
        "end": 11.329,
        "key": false
      }
    ]
  },
  {
    "id": "caption-group-4",
    "frame": 2,
    "start": 11.829,
    "end": 14.042,
    "text": "这句话先开一个 turn。",
    "words": [
      {
        "id": "caption-word-4-0",
        "text": "这句话先开一个 turn。",
        "start": 11.829,
        "end": 13.822,
        "key": false
      }
    ]
  },
  {
    "id": "caption-group-5",
    "frame": 2,
    "start": 14.042,
    "end": 15.854,
    "text": "turn 不是一次请求。",
    "words": [
      {
        "id": "caption-word-5-0",
        "text": "turn 不是一次请求。",
        "start": 14.042,
        "end": 15.634,
        "key": false
      }
    ]
  },
  {
    "id": "caption-group-6",
    "frame": 2,
    "start": 15.854,
    "end": 20.496,
    "text": "它是一个循环：把已经接纳的输入，一直做到排空。",
    "words": [
      {
        "id": "caption-word-6-0",
        "text": "它是一个循环：把已经接纳的输入，一直做到排空。",
        "start": 15.854,
        "end": 20.276,
        "key": false
      }
    ]
  },
  {
    "id": "caption-group-7",
    "frame": 2,
    "start": 20.496,
    "end": 24.329,
    "text": "循环里每发一次模型请求，叫一个 step。",
    "words": [
      {
        "id": "caption-word-7-0",
        "text": "循环里每发一次模型请求，叫一个 step。",
        "start": 20.496,
        "end": 24.109,
        "key": false
      }
    ]
  },
  {
    "id": "caption-group-8",
    "frame": 2,
    "start": 24.329,
    "end": 28.656,
    "text": "一个 step 不只是请求，还包含这次请求引起的工具。",
    "words": [
      {
        "id": "caption-word-8-0",
        "text": "一个 step 不只是请求，还包含这次请求引起的工具。",
        "start": 24.329,
        "end": 28.156,
        "key": false
      }
    ]
  },
  {
    "id": "caption-group-9",
    "frame": 3,
    "start": 28.656,
    "end": 32.648,
    "text": "所以一个 turn 里可以有很多 step，也可以只有一个。",
    "words": [
      {
        "id": "caption-word-9-0",
        "text": "所以一个 turn 里可以有很多 step，也可以只有一个。",
        "start": 28.656,
        "end": 32.428,
        "key": false
      }
    ]
  },
  {
    "id": "caption-group-10",
    "frame": 3,
    "start": 32.648,
    "end": 38.782,
    "text": "模型用完工具，觉得还得再看一眼，同一轮里就再开一个 step。",
    "words": [
      {
        "id": "caption-word-10-0",
        "text": "模型用完工具，觉得还得再看一眼，同一轮里就再开一个 step。",
