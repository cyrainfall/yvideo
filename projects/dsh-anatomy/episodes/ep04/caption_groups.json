        "end": 38.562,
        "key": false
      }
    ]
  },
  {
    "id": "caption-group-11",
    "frame": 3,
    "start": 38.782,
    "end": 43.876,
    "text": "什么时候停？这一步已经有了结论，并且没有新输入在等。",
    "words": [
      {
        "id": "caption-word-11-0",
        "text": "什么时候停？这一步已经有了结论，并且没有新输入在等。",
        "start": 38.782,
        "end": 43.656,
        "key": false
      }
    ]
  },
  {
    "id": "caption-group-12",
    "frame": 3,
    "start": 43.876,
    "end": 48.747,
    "text": "刚才那一轮，四个字的输入，六十八个 step。",
    "words": [
      {
        "id": "caption-word-12-0",
        "text": "刚才那一轮，四个字的输入，六十八个 step。",
        "start": 43.876,
        "end": 48.247,
        "key": false
      }
    ]
