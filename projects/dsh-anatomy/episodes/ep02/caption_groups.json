        "key": false
      }
    ]
  },
  {
    "id": "caption-group-6",
    "frame": 2,
    "start": 15.723,
    "end": 21.244,
    "text": "apply 收下一个上下文，插件的所有贡献，都从它出发。",
    "words": [
      {
        "id": "caption-word-6-0",
